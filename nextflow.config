docker {
    enabled = true
    runOptions = "--entrypoint=''"
}

report {
    enabled = true
    overwrite = true
    file = 'reports/report.html'
}

trace {
    enabled = true
    overwrite = true
    file = 'reports/trace.txt'
}

process {
    executor = 'local'
    scratch = false

    withName: downloadTree {
        container = "evolbioinfo/ubuntu:v24.04"
    }
    withName: listTips {
        container = "evolbioinfo/gotree:v0.4.1a"
    }
}
